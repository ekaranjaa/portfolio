---
import { Font } from 'astro:assets'
import { portfolio } from '@/data/portfolio.ts'

interface Props {
    title?: string
    description?: string
}

const { site, hero, experience, services, socials } = portfolio
const { title = site.title, description = site.description } = Astro.props

const siteUrl = new URL('/', Astro.site).href
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL(site.ogImage.src, Astro.site).href

// One graph, so search engines read the site and the person behind it as linked entities.
const personId = `${siteUrl}#person`
const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            '@id': `${siteUrl}#website`,
            url: siteUrl,
            name: site.name,
            description: site.description,
            inLanguage: 'en-KE',
            author: { '@id': personId },
        },
        {
            '@type': 'Person',
            '@id': personId,
            name: site.name,
            url: siteUrl,
            image: new URL(hero.image.src, Astro.site).href,
            jobTitle: hero.title,
            description: site.description,
            email: site.email,
            worksFor: { '@type': 'Organization', name: experience.jobs[0].company },
            knowsAbout: services,
            sameAs: [...socials.map((social) => social.href), site.x.href],
        },
    ],
}
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicons, generated by RealFaviconGenerator -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-lova" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content={site.keywords.join(', ')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.x.handle} />
    <meta name="twitter:creator" content={site.x.handle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImage.alt} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
